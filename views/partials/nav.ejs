<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Home">
      <span class="logo-text">WebDev Learn</span>
    </a>

    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" id="navToggle">
      <span class="hamburger"></span>
    </button>

    <nav class="main-nav" id="mainNav" aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/lessons" class="nav-link">Lessons</a></li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/contact" class="nav-link">Contact</a></li>

        <% if (isAuthenticated) { %>
          <% if (isAdmin) { %>
            <li><a href="/admin" class="nav-link">Dashboard</a></li>
          <% } %>
          <li><a href="/account" class="nav-link">My Account</a></li>
          <li>
            <form action="/logout" method="POST" class="inline-form">
              <button type="submit" class="nav-link btn-link">Logout</button>
            </form>
          </li>
        <% } else { %>
          <li><a href="/login" class="nav-link">Login</a></li>
          <li><a href="/register" class="nav-link btn-primary-nav">Register</a></li>
        <% } %>
      </ul>
    </nav>
  </div>
</header>
