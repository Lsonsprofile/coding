<%- include('../partials/head') %>
<% if (!page.settings || page.settings.showHeader !== false) { %><%- include('../partials/nav') %><% } %>
<% if (typeof isPreview !== 'undefined' && isPreview) { %>
  <div class="preview-banner">Preview mode — this page may be a draft and is only visible to admins.</div>
<% } %>

<main id="main-content" class="container lesson-page">
  <article>
    <header class="lesson-header">
      <% if (page.weekNumber) { %>
        <span class="week-badge">Week <%= page.weekNumber %></span>
      <% } %>
      <h1><%= page.title %></h1>
      <% if (page.description) { %>
        <p class="lead"><%= page.description %></p>
      <% } %>
    </header>

    <div class="lesson-content">
      <% if (!contentBlocks || contentBlocks.length === 0) { %>
        <p class="empty-state">This lesson has no content blocks yet.</p>
      <% } else { %>
        <% contentBlocks.forEach(function(block) { %>
          <%- include('../partials/render-block', { block: block, root: true }) %>
        <% }) %>
      <% } %>
    </div>

    <!-- Comments -->
    <section id="comments" class="comments-section">
      <h2>Comments</h2>

      <% if (typeof commentError !== 'undefined' && commentError === 'comment-empty') { %>
        <div class="alert alert-error">Please write a comment before submitting.</div>
      <% } %>

      <% if (isAuthenticated) { %>
        <form action="/lesson/<%= page.slug %>/comments" method="POST" class="comment-form">
          <div class="form-group">
            <label for="comment-content">Add a comment</label>
            <textarea id="comment-content" name="content" rows="3" required minlength="2" maxlength="2000"
                      placeholder="Share your thoughts or questions…"></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
        </form>
      <% } else { %>
        <p class="comments-login-prompt">
          <a href="/login">Log in</a> to post a comment.
        </p>
      <% } %>

      <% const lessonComments = (typeof comments !== 'undefined' && comments) ? comments : []; %>
      <% if (lessonComments.length === 0) { %>
        <p class="comments-empty">No comments yet. Be the first to share your thoughts.</p>
      <% } else { %>
        <ul class="comment-list">
          <% lessonComments.forEach(function(c) { %>
            <li class="comment-item">
              <div class="comment-meta">
                <strong><%= c.user && c.user.name ? c.user.name : 'User' %></strong>
                <time datetime="<%= c.createdAt %>"><%= new Date(c.createdAt).toLocaleDateString() %></time>
              </div>
              <p class="comment-body"><%= c.content %></p>
              <% if (isAuthenticated && (isAdmin || (currentUser && String(currentUser._id) === String(c.userId)))) { %>
                <form action="/comments/<%= c._id %>/delete" method="POST" class="inline-form"
                      onsubmit="return confirm('Delete this comment?');">
                  <input type="hidden" name="redirectSlug" value="<%= page.slug %>">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <nav class="lesson-nav" aria-label="Lesson navigation">
      <a href="/lessons" class="btn btn-secondary">← All Lessons</a>
    </nav>
  </article>
</main>

<% if (!page.settings || page.settings.showFooter !== false) { %><%- include('../partials/footer') %><% } %>
