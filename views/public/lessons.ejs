<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main-content" class="container">
  <header class="page-header">
    <h1>36-Week Web Development Curriculum</h1>
    <p class="lead">
      Progressive lessons covering HTML, CSS, JavaScript and full-stack concepts.
      All content is stored in the database and can be edited by administrators.
    </p>
  </header>

  <% const lessonPages = (typeof pages !== "undefined" && pages) ? pages : []; %>
  <% if (lessonPages.length === 0) { %>
    <div class="empty-state">
      <p>No published lessons yet. An administrator needs to create and publish pages.</p>
    </div>
  <% } else { %>
    <div class="lesson-grid">
      <% lessonPages.forEach(function(page) { %>
        <article class="lesson-card">
          <% if (page.weekNumber) { %>
            <span class="week-badge">Week <%= page.weekNumber %></span>
          <% } %>
          <h2 class="lesson-title">
            <a href="/lesson/<%= page.slug %>"><%= page.title %></a>
          </h2>
          <% if (page.description) { %>
            <p class="lesson-desc"><%= page.description %></p>
          <% } %>
          <a href="/lesson/<%= page.slug %>" class="btn btn-secondary btn-sm">View Lesson</a>
        </article>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
